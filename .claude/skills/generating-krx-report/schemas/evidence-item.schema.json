{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-item.schema.json",
  "title": "Evidence Item",
  "description": "모든 분석 근거의 공통 표현. 수치든 서술이든 이 형식으로만 모듈에 전달된다. 출처·기준일·단위·수집경로가 없는 근거는 존재할 수 없다.",
  "type": "object",
  "required": [
    "evidence_id",
    "module",
    "evidence_type",
    "source",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^[A-Z]{1,3}-[A-Z0-9]+-[0-9]{3}$",
      "description": "예: Q-PROFIT-001, G-CAGR-002, V-PER-001"
    },
    "module": {
      "type": "string",
      "enum": ["business", "quality", "growth", "moat", "valuation", "trend", "risk", "catalyst", "shared"]
    },
    "evidence_type": {
      "type": "string",
      "enum": ["metric", "statement", "filing_text", "event", "timeseries"],
      "description": "metric=수치, statement=공시 서술, filing_text=원문 발췌, event=공시 사건, timeseries=시계열"
    },
    "metric": {
      "type": ["string", "null"],
      "description": "evidence_type=metric 일 때 config/module-registry.yaml 의 metric 키와 일치해야 한다."
    },
    "label": {
      "type": ["string", "null"],
      "description": "사람이 읽는 항목명"
    },
    "value": {
      "type": ["number", "string", "boolean", "null"],
      "description": "null 은 '데이터 없음(N/A)'을 의미한다. **0 과 명확히 구분된다.** NaN/Infinity 금지."
    },
    "unit": {
      "type": ["string", "null"],
      "description": "%, x, KRW, 주, %p 등. value 가 number 이면 필수."
    },
    "period_start": {
      "type": ["string", "null"],
      "format": "date"
    },
    "period_end": {
      "type": ["string", "null"],
      "format": "date"
    },
    "period_type": {
      "type": ["string", "null"],
      "enum": ["quarter_standalone", "quarter_cumulative", "annual", "ttm", "point_in_time", "range", null],
      "description": "누적·분기단독 혼용을 막는 핵심 필드. 서로 다른 period_type 을 한 계산식에 섞으면 Gate 2 실패."
    },
    "fs_div": {
      "type": ["string", "null"],
      "enum": ["CFS", "OFS", null],
      "description": "연결(CFS)/별도(OFS). DART 재무 수치이면 필수. 한 계산식 안에서 혼용 금지."
    },
    "comparison": {
      "type": ["object", "null"],
      "description": "YoY 등 비교의 상대 기간. 동일 period_type 끼리만 비교 가능.",
      "additionalProperties": false,
      "properties": {
        "basis": {"type": "string", "enum": ["yoy", "qoq", "cagr", "vs_index", "vs_peer", "vs_history"]},
        "compared_period_start": {"type": ["string", "null"]},
        "compared_period_end": {"type": ["string", "null"]},
        "compared_value": {"type": ["number", "null"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["provider", "source_type", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["dart", "pykrx", "krx_open_api", "internal"]
        },
        "source_type": {
          "type": "string",
          "enum": [
            "official_api",
            "official_filing",
            "official_download",
            "unofficial_wrapper",
            "derived_calculation"
          ]
        },
        "underlying_source": {
          "type": ["string", "null"],
          "description": "비공식 래퍼일 때 실제 원천. 예: pykrx → 'KRX' 또는 'Naver Finance'"
        },
        "rcept_no": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{14}$",
          "description": "DART 수치이면 **필수**. 14자리 접수번호."
        },
        "url_or_identifier": {"type": ["string", "null"]},
        "endpoint_or_function": {
          "type": ["string", "null"],
          "description": "실제 호출한 엔드포인트/함수명. source-priority.yaml 에 등재된 것만 허용."
        },
        "retrieved_at": {
          "type": "string",
          "description": "ISO8601. 미래 시각 금지."
        }
      }
    },
    "calculation": {
      "type": ["object", "null"],
      "description": "source_type=derived_calculation 이면 **필수**. 재현 가능해야 한다 (Gate 3).",
      "required": ["formula", "input_evidence_ids"],
      "additionalProperties": false,
      "properties": {
        "formula": {"type": "string", "description": "예: 'operating_income_ttm / revenue_ttm * 100'"},
        "inputs": {"type": "object", "description": "실제 입력 수치. 재현 검증에 사용."},
        "input_evidence_ids": {
          "type": "array",
          "items": {"type": "string"},
          "description": "상위 evidence 로의 근거 체인. 입력이 원시 공시 행인 기초 지표(revenue_ttm 등)는 연결할 evidence 가 없어 비어 있을 수 있으며, 이때 출처는 source.rcept_no 로 추적된다. **둘 다 없으면 Gate 2 실패** (validate_evidence.py 가 강제)."
        }
      }
    },
    "text": {
      "type": ["string", "null"],
      "description": "evidence_type 이 statement/filing_text/event 일 때의 인용문. 원문을 변형하지 않는다."
    },
    "verification": {
      "type": "string",
      "enum": ["pending", "verified", "failed", "not_applicable"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"},
      "description": "예: '종가 기준일과 발행주식수 기준일이 다름', 'OFS 폴백 적용'"
    }
  }
}
