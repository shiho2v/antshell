# =====================
# 📋 사용법: cp .env.example .env  →  .env에 실제 값 입력
# 이 파일(.env.example)은 git에 올라갑니다. 실제 .env는 올라가지 않습니다.
# =====================

# ── Database (Supabase) ───────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── 주식 데이터 API ────────────────────────
# DART: opendart.fss.or.kr → 인증키 신청
DART_API_KEY=your-dart-api-key

# KIS: apiportal.koreainvestment.com (계좌 필요)
KIS_APP_KEY=your-kis-app-key
KIS_APP_SECRET=your-kis-app-secret
KIS_ACCOUNT_NO=00000000-00
KIS_IS_MOCK=true

# BigKinds: bigkinds.or.kr
BIGKINDS_API_KEY=your-bigkinds-api-key

# ── Notion 연동 ────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxx
NOTION_CHANGELOG_PAGE_ID=32자리페이지ID
NOTION_WEEKLY_PAGE_ID=32자리페이지ID

# ── Claude API (뉴스·공시 요약용) ──────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxx

# ── Redis ─────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── GitHub (MCP용, 선택) ───────────────────
GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# ── 서버 설정 ──────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
