{
  "name": "study-week-preflight",
  "domain": "Weekly study-cadence readiness + repo health preflight for a 9-person Korean stock-analysis study team (12-week presenter rotation, PR-based collaboration)",
  "source_request": "매주 발표자 차례가 오기 전에 스터디 주차 문서와 저장소 상태(브랜치 규칙, 훅, 품질 게이트)가 준비됐는지 자동으로 점검해주는 하네스",
  "patterns": ["Pipeline", "Fan-out/Fan-in"],
  "specialists": [
    { "role": "week-context",       "primitive": "sub-agent",        "isolation": "none", "effort": "low",    "model": "haiku"  },
    { "role": "branch-pr-audit",    "primitive": "dynamic-workflow", "isolation": "none", "effort": "medium", "model": "sonnet" },
    { "role": "harness-health",     "primitive": "dynamic-workflow", "isolation": "none", "effort": "medium", "model": "sonnet" },
    { "role": "quality-gate-probe", "primitive": "dynamic-workflow", "isolation": "none", "effort": "medium", "model": "sonnet" },
    { "role": "weekly-doc-audit",   "primitive": "dynamic-workflow", "isolation": "none", "effort": "medium", "model": "sonnet" },
    { "role": "readiness-brief",    "primitive": "sub-agent",        "isolation": "none", "effort": "high",   "model": "sonnet" }
  ],
  "sprint_contract": {
    "dimensions": [
      "branch_convention_compliance", "hook_health_pass", "quality_gate_runnable",
      "test_suite_execution_coverage", "weekly_doc_readiness",
      "presenter_metadata_consistency", "report_actionability"
    ],
    "thresholds": {
      "branch_convention_compliance": 1.0, "hook_health_pass": 1.0,
      "quality_gate_runnable": 1.0, "test_suite_execution_coverage": 1.0,
      "weekly_doc_readiness": 1.0, "presenter_metadata_consistency": 1.0,
      "report_actionability": 1.0
    }
  },
  "entry_command": "/harness:study-week-preflight",
  "runner_workflow": "hns-study-week-preflight-run.js"
}
